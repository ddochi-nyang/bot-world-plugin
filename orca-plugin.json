{
  "manifestVersion": 2,
  "id": "bot-world",
  "name": "Bot World",
  "version": "0.1.1",
  "description": "Read-only virtual office visualizer for Orca bots and live sub-workers",
  "license": "MIT",
  "author": {
    "name": "ddochi-nyang",
    "url": "https://github.com/ddochi-nyang"
  },
  "repository": "https://github.com/ddochi-nyang/bot-world-plugin",
  "icon": "assets/icon.png",
  "engines": {
    "orca": ">=1.4.265"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "agent:read"
    }
  ],
  "contributes": {
    "panels": [
      {
        "id": "bot-world",
        "title": "Bot World",
        "icon": "bot",
        "entry": "panel/index.html",
        "ui": "html"
      }
    ],
    "customEditors": [
      {
        "id": "bot-world-stage",
        "title": "Bot World Office",
        "extensions": [
          ".botworld"
        ],
        "entry": "editor/index.html",
        "priority": "default",
        "frame": "isolated"
      }
    ],
    "newFiles": [
      {
        "id": "new-botworld",
        "title": "New Bot World Board",
        "extension": ".botworld",
        "template": "templates/default.botworld"
      }
    ],
    "commands": [
      {
        "id": "bot-world.open",
        "title": "Open Bot World"
      },
      {
        "id": "bot-world.refresh",
        "title": "Refresh Bot World"
      }
    ],
    "statusBarItems": [
      {
        "id": "bot-world-status",
        "text": "Bot World",
        "icon": "bot",
        "command": "bot-world.open"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "settings": [
      {
        "key": "defaultTheme",
        "title": "Default Office Theme",
        "type": "string",
        "enum": [
          "startup_office",
          "corporate_office"
        ],
        "enumLabels": [
          "Startup Office",
          "Corporate Office"
        ],
        "default": "startup_office",
        "description": "Default office canvas theme (startup_office or corporate_office)"
      },
      {
        "key": "redactMode",
        "title": "Redact Mode",
        "type": "boolean",
        "default": false,
        "description": "Hide sensitive task titles, tool names, message bodies, and event summaries"
      },
      {
        "key": "pollIntervalSec",
        "title": "Poll Interval (seconds)",
        "type": "integer",
        "minimum": 2,
        "maximum": 60,
        "default": 5,
        "description": "Default status polling interval in seconds (2-60)"
      },
      {
        "key": "language",
        "title": "Language",
        "type": "string",
        "enum": [
          "auto",
          "en",
          "ko"
        ],
        "enumLabels": [
          "Auto (Follow Orca)",
          "English",
          "한국어"
        ],
        "default": "auto",
        "description": "Display language for Bot World (auto follows Orca UI locale)"
      }
    ]
  }
}
